# Copiar para `.env` e preencher. O `.env` está no .gitignore e NUNCA vai
# para o GitHub. Em produção, estas variáveis vivem no painel da Vercel.

# ─── Base de dados (a ÚNICA obrigatória) ───────────────────────────────────
# Local (npm run db:start arranca este Postgres):
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/financeiro"
#
# Em produção, as integrações da Vercel preenchem isto sozinhas. A aplicação
# também aceita POSTGRES_PRISMA_URL, POSTGRES_URL, DATABASE_URL_UNPOOLED e
# POSTGRES_URL_NON_POOLING, para não ser preciso copiar valores à mão.

# ─── Opcionais ─────────────────────────────────────────────────────────────

# Endereço público, para os links de recuperação de palavra-passe.
# Na Vercel é descoberto sozinho; só é preciso com domínio próprio.
# NEXT_PUBLIC_APP_URL="https://financas.exemplo.pt"

# Só para `npm run setup:admin` (criar o administrador pelo terminal).
# Não é preciso na Vercel: a primeira conta cria-se na própria aplicação,
# em /instalar.
# ADMIN_EMAIL="tu@exemplo.com"
# ADMIN_NAME="Administrador"
