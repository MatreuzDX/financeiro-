# Copiar para `.env` e preencher. O `.env` está no .gitignore e NUNCA vai
# para o GitHub. Em produção, estas variáveis vivem no painel da Vercel.

# ─── Base de dados ─────────────────────────────────────────────────────────
# Local (npm run db:start arranca este Postgres):
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/financeiro"
# Produção (Neon): postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/db?sslmode=require

# ─── Sessões ───────────────────────────────────────────────────────────────
# 32+ bytes aleatórios. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Mudar este valor invalida TODAS as sessões abertas.
SESSION_SECRET=""

# ─── Administrador inicial ─────────────────────────────────────────────────
# `npm run setup:admin` cria esta conta e mostra UMA vez uma palavra-passe
# aleatória forte. A palavra-passe nunca é lida daqui nem guardada aqui.
ADMIN_EMAIL="tu@exemplo.com"
ADMIN_NAME="Administrador"

# ─── Aplicação ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
