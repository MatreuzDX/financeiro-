// Gestão financeira pessoal e profissional
// Ver docs/PLANO-ARQUITETURA.md (secção 5) para o raciocínio por trás disto.
//
// ─── CONVENÇÕES DE UNIDADES ────────────────────────────────────────────────
// Nada de vírgula flutuante. Todos os valores são inteiros exatos.
//
//   *Cents   Int   cêntimos.        €920,00  → 92000
//   *Metres  Int   metros.          150,0 km → 150000
//   *Ml      Int   mililitros.      12,345 L → 12345
//   *E4      Int   euros × 10 000.  €1,6890  → 16890   (preços com 4 casas)
//
// Limite do Int: 2 147 483 647 → €21 474 836,47 por linha. Suficiente para
// finanças pessoais e profissionais de pequena escala; se um dia não for,
// a migração para BigInt é uma coluna de cada vez.
//
// ─── LIVRO DE LANÇAMENTOS ──────────────────────────────────────────────────
// Uma Transaction é só o cabeçalho. O dinheiro vive nas Entry, e a soma das
// Entry de cada Transaction é SEMPRE zero — garantido por um trigger, não por
// confiança no código. Ver prisma/migrations/*_ledger_constraints.
//
// Sinal: positivo = dinheiro entra no "recipiente" dessa linha.
//   Despesa 50€ no cartão:   Account(cartão) −5000 · Category(Alimentação) +5000
//   Receita 920€ no banco:   Account(banco)  +92000 · Category(Ordenado)  −92000
//   Transferência 200€:      Account(ordem)  −20000 · Account(poupança)   +20000
// A transferência não toca em nenhuma Category — por isso não mexe no lucro.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: a connection string vive em prisma.config.ts, não aqui.
datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════════════
// IDENTIDADE E ACESSO
// ═══════════════════════════════════════════════════════════════════════════

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

model User {
  id                 String          @id @default(cuid())
  name               String
  email              String          @unique
  passwordHash       String
  role               Role            @default(MEMBER)
  mustChangePassword Boolean         @default(false)
  theme              ThemePreference @default(SYSTEM)
  activeWorkspaceId  String?
  lastLoginAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  sessions    Session[]
  memberships Membership[]
  resetTokens PasswordResetToken[]

  @@index([email])
}

/// Sessão do lado do servidor. O cookie transporta um token aleatório; aqui
/// guarda-se apenas o SHA-256 dele — quem ler a base não consegue passar por
/// ninguém.
model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  ipHash       String?
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Token de recuperação de palavra-passe. Também só o hash é guardado.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Contador de tentativas falhadas, por chave (email ou IP). A Vercel é
/// serverless — um contador em memória não sobrevive entre pedidos, por isso
/// o rate limiting vive na base de dados.
model LoginAttempt {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  blockedUntil DateTime?
}

// ═══════════════════════════════════════════════════════════════════════════
// MULTI-TENANCY  (a preparação para SaaS — ver plano, secção 15)
// ═══════════════════════════════════════════════════════════════════════════

enum Plan {
  FREE
  PRO
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("EUR")
  timezone  String   @default("Europe/Lisbon")
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  entries       Entry[]
  incomeSources IncomeSource[]
  vehicles      Vehicle[]
  mileageLogs   MileageLog[]
  fuelLogs      FuelLog[]
  workJobs       WorkJob[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  goals          Goal[]
  invites        Invite[]
  importBatches  ImportBatch[]
  categoryRules  CategoryRule[]
  fiscalProfile  FiscalProfile?
  aiUsage        AiUsage[]
  reconciliacoes Reconciliation[]
}

/// Uso do assistente, por mes.
///
/// Existe por uma razao so: uma API paga sem tecto e uma fatura surpresa. O
/// limite e por espaco e por mes, e a app diz quanto falta antes de gastar.
model AiUsage {
  id           String   @id @default(cuid())
  workspaceId  String
  /// "AAAA-MM".
  month        String
  perguntas    Int      @default(0)
  tokensEntrada Int     @default(0)
  tokensSaida   Int     @default(0)
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, month])
}

/// Perfil fiscal portugues, para separar o dinheiro que esta na conta e nao e
/// seu. Ver `src/lib/fiscal.ts` — as contas vivem la, isto e so o que a
/// pessoa configurou.
///
/// As taxas guardam-se em centesimos de ponto percentual (2140 = 21,40%), pela
/// mesma razao que o dinheiro se guarda em centimos: nada de virgula flutuante.
model FiscalProfile {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  independente    Boolean  @default(false)
  /// "ISENTO_ART53" ou "NORMAL".
  regimeIva       String   @default("ISENTO_ART53")
  retencaoNaFonte Boolean  @default(false)
  /// "AAAA-MM" do inicio de atividade, para a isencao dos 12 meses.
  inicioAtividade String?
  taxaSs          Int      @default(2140)
  coeficienteSs   Int      @default(7000)
  taxaIva         Int      @default(2300)
  taxaRetencao    Int      @default(2300)
  reservaIrs      Int      @default(2000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Convite para alguém se juntar a um espaço.
///
/// Não há serviço de email configurado, por isso o convite é um LINK que
/// quem convida copia e envia por onde quiser — WhatsApp, mensagem, papel.
/// Para um casal ou uma família isso é melhor do que email, não pior.
///
/// Guarda-se só o hash do token: quem ler a base não consegue entrar com ele.
model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(MEMBER)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, acceptedAt])
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(OWNER)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ═══════════════════════════════════════════════════════════════════════════
// NÚCLEO FINANCEIRO
// ═══════════════════════════════════════════════════════════════════════════

enum AccountType {
  BANK
  CASH
  CARD
  SAVINGS
  INVESTMENT
  LOAN
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum Scope {
  PERSONAL
  BUSINESS
}

/// Onde o dinheiro está. Banco, dinheiro vivo, cartão, poupança.
/// O saldo é derivado das Entry; `cachedBalanceCents` é só um atalho de
/// leitura, atualizado na MESMA transação SQL e verificado por
/// `npm run check:invariants`.
model Account {
  id                 String      @id @default(cuid())
  workspaceId        String
  name               String
  type               AccountType @default(BANK)
  institution        String?
  currency           String      @default("EUR")
  openingCents       Int         @default(0)
  cachedBalanceCents Int         @default(0)
  icon               String?
  color              String?
  sortOrder          Int         @default(0)
  archived           Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries        Entry[]
  recurringRules RecurringRule[]
  reconciliacoes Reconciliation[]

  @@unique([workspaceId, name])
  @@index([workspaceId, archived, sortOrder])
}

/// Para onde o dinheiro vai (ou de onde vem). Árvore: uma categoria pode ter
/// subcategorias.
model Category {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  type        CategoryType
  parentId    String?
  scope       Scope        @default(PERSONAL)
  icon        String?
  color       String?
  sortOrder   Int          @default(0)
  isSystem    Boolean      @default(false)
  archived    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      Category?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]      @relation("CategoryTree")
  entries     Entry[]
  budgetLines BudgetLine[]
  recurringRules RecurringRule[]
  categoryRules  CategoryRule[]

  @@unique([workspaceId, name, type])
  @@index([workspaceId, type, archived])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  CLEARED
  SCHEDULED
  VOID
}

/// Cabeçalho de um movimento. Os valores estão nas Entry.
model Transaction {
  id          String            @id @default(cuid())
  workspaceId String
  date        DateTime          @db.Date
  type        TransactionType
  status      TransactionStatus @default(CLEARED)
  scope       Scope             @default(PERSONAL)
  description String
  notes       String?

  incomeSourceId String?
  vehicleId      String?
  workJobId      String?
  /// Instância gerada por uma regra de recorrência.
  recurringId    String?
  /// Data de vencimento, para contas a pagar e a receber.
  dueDate        DateTime? @db.Date

  /// Lote de importação a que este movimento pertence, quando veio de um
  /// extrato. É o que permite desfazer uma importação inteira.
  importBatchId  String?
  /// Impressão digital da linha do extrato. Ver `src/server/import.ts`.
  importHash     String?

  createdById String?
  revision    Int       @default(1)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incomeSource IncomeSource?  @relation(fields: [incomeSourceId], references: [id], onDelete: Restrict)
  vehicle      Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  workJob      WorkJob?       @relation(fields: [workJobId], references: [id], onDelete: SetNull)
  recurring    RecurringRule? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  importBatch  ImportBatch?   @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  entries      Entry[]

  @@index([workspaceId, deletedAt, date])
  @@index([workspaceId, type, date])
  @@index([workspaceId, scope, date])
  @@index([workspaceId, vehicleId, date])
  @@index([workspaceId, incomeSourceId, date])
  @@index([workspaceId, status, dueDate])
  @@index([workspaceId, importBatchId])
  /// Impede que a mesma recorrência gere duas vezes o mesmo mês.
  @@unique([recurringId, date])
  /// Impede que o mesmo movimento do extrato entre duas vezes, mesmo que os
  /// ficheiros importados se sobreponham. `importHash` é nulo em tudo o que
  /// foi registado à mão, e o Postgres deixa repetir nulos — por isso esta
  /// restrição só aperta onde deve.
  @@unique([workspaceId, importHash])
}

/// Uma importação de extrato.
///
/// Existe para a importação poder ser DESFEITA de uma vez. Importar o ficheiro
/// errado, ou o mês errado, é um engano vulgar; sem isto, a única saída era
/// apagar duzentos movimentos um a um.
model ImportBatch {
  id          String   @id @default(cuid())
  workspaceId String
  accountId   String
  filename    String
  /// Linhas lidas, importadas e saltadas — a conta que a app mostra depois.
  totalRows    Int     @default(0)
  importedRows Int     @default(0)
  skippedRows  Int     @default(0)
  undoneAt    DateTime?
  createdById String?
  createdAt   DateTime @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([workspaceId, createdAt])
}

/// "Se a descrição contiver PINGO DOCE, é Supermercado."
///
/// É o motor de regras do Firefly III, reduzido ao que resolve 80% do
/// trabalho: procurar um pedaço de texto na descrição. Sem expressões
/// regulares — quem importa um extrato não quer aprender `^(?:.*)$`.
model CategoryRule {
  id          String   @id @default(cuid())
  workspaceId String
  /// Guardado já normalizado (sem acentos, minúsculas) para comparar depressa.
  pattern     String
  /// O texto tal como a pessoa o escreveu, para lho mostrar de volta.
  label       String
  categoryId  String
  scope       Scope    @default(PERSONAL)
  /// Quantas vezes já acertou. Serve para ordenar e para dar confiança.
  hits        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, pattern])
  @@index([workspaceId])
}

// ═══════════════════════════════════════════════════════════════════════════
// RECORRÊNCIAS E CONTAS A PAGAR
// ═══════════════════════════════════════════════════════════════════════════

enum Frequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

/// A regra. As ocorrências nascem daqui como Transaction com estado
/// SCHEDULED — que NÃO conta para saldos nem para lucro enquanto não for
/// confirmada. Dinheiro que ainda não saiu não pode aparecer como se tivesse
/// saído.
model RecurringRule {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  type        TransactionType
  amountCents Int
  scope       Scope           @default(PERSONAL)

  accountId  String
  categoryId String?

  frequency  Frequency @default(MONTHLY)
  /// Dia do mês (1-31). Meses curtos usam o último dia disponível.
  dayOfMonth Int?
  /// Dia da semana (1 = segunda … 7 = domingo), para as semanais.
  weekday    Int?
  /// Mês (1-12), para as anuais.
  monthOfYear Int?

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  active    Boolean   @default(true)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([workspaceId, active])
}

// ═══════════════════════════════════════════════════════════════════════════
// METAS
// ═══════════════════════════════════════════════════════════════════════════

/// Um objetivo com um valor a atingir. O progresso é a SOMA das contribuições
/// registadas — e não o saldo de uma conta, porque a mesma conta serviria
/// várias metas ao mesmo tempo e a mesma poupança seria contada duas vezes.
model Goal {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  targetCents Int
  deadline    DateTime? @db.Date
  color       String?
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@unique([workspaceId, name])
  @@index([workspaceId, archived])
}

model GoalContribution {
  id          String   @id @default(cuid())
  workspaceId String
  goalId      String
  date        DateTime @db.Date
  amountCents Int
  note        String?
  createdAt   DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
}

/// Uma linha do livro. Aponta para UMA conta OU UMA categoria, nunca ambas,
/// nunca nenhuma (CHECK na base de dados). A soma das linhas de cada
/// transação é zero (trigger na base de dados).
model Entry {
  id            String  @id @default(cuid())
  workspaceId   String
  transactionId String
  accountId     String?
  categoryId    String?
  amountCents   Int
  memo          String?

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     Account?    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([workspaceId, accountId])
  @@index([workspaceId, categoryId])
}

// ═══════════════════════════════════════════════════════════════════════════
// TRABALHO
// ═══════════════════════════════════════════════════════════════════════════

enum IncomeSourceType {
  SALARY
  DELIVERY
  FREELANCE
  BUSINESS
  RENTAL
  OTHER
}

model IncomeSource {
  id          String           @id @default(cuid())
  workspaceId String
  name        String
  type        IncomeSourceType @default(OTHER)
  scope       Scope            @default(BUSINESS)
  color       String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  workJobs     WorkJob[]

  @@unique([workspaceId, name])
  @@index([workspaceId, active])
}

enum PayModel {
  PER_KM
  PER_DELIVERY
  HOURLY
  FIXED
}

/// Um turno / trabalho / serviço prestado. "Trabalhei para a Pizzaria X,
/// 150 km a €0,40/km" → grossCents = 6000, e nasce a receita correspondente.
model WorkJob {
  id             String   @id @default(cuid())
  workspaceId    String
  incomeSourceId String
  vehicleId      String?
  clientName     String
  date           DateTime @db.Date

  payModel        PayModel @default(PER_KM)
  distanceMetres  Int      @default(0)
  ratePerKmCents  Int      @default(0)
  deliveries      Int      @default(0)
  ratePerDeliveryCents Int @default(0)
  hoursTenths     Int      @default(0) // 2,5 h → 25
  ratePerHourCents Int     @default(0)
  fixedCents      Int      @default(0)
  tipsCents       Int      @default(0)
  /// Calculado no servidor a partir dos campos acima. Nunca vem do cliente.
  grossCents      Int      @default(0)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incomeSource IncomeSource  @relation(fields: [incomeSourceId], references: [id], onDelete: Restrict)
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  mileageLogs  MileageLog[]

  @@index([workspaceId, date])
  @@index([workspaceId, incomeSourceId, date])
}

// ═══════════════════════════════════════════════════════════════════════════
// VEÍCULOS
// ═══════════════════════════════════════════════════════════════════════════

enum VehicleType {
  MOTORCYCLE
  SCOOTER
  CAR
  VAN
  BICYCLE
  OTHER
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  LPG
  NONE
}

model Vehicle {
  id           String      @id @default(cuid())
  workspaceId  String
  name         String
  brand        String?
  model        String?
  year         Int?
  plate        String?
  type         VehicleType @default(MOTORCYCLE)
  fuelType     FuelType    @default(PETROL)
  /// Conta-quilómetros atual, em metros. 24 150,5 km → 24150500
  currentMetres Int        @default(0)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mileageLogs  MileageLog[]
  fuelLogs     FuelLog[]
  workJobs     WorkJob[]
  transactions Transaction[]

  @@unique([workspaceId, name])
  @@index([workspaceId, active])
}

enum MileagePurpose {
  WORK
  PERSONAL
}

model MileageLog {
  id          String         @id @default(cuid())
  workspaceId String
  vehicleId   String
  workJobId   String?
  date        DateTime       @db.Date
  startMetres Int
  endMetres   Int
  /// endMetres − startMetres. Calculado no servidor; nunca aceite do cliente.
  totalMetres Int
  purpose     MileagePurpose @default(WORK)
  notes       String?
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workJob   WorkJob?  @relation(fields: [workJobId], references: [id], onDelete: SetNull)

  @@index([workspaceId, vehicleId, date])
}

/// Abastecimento. Serve para o consumo real (L/100 km) e entra no custo/km.
model FuelLog {
  id              String   @id @default(cuid())
  workspaceId     String
  vehicleId       String
  date            DateTime @db.Date
  odometerMetres  Int
  litersMl        Int
  /// Preço por litro em euros × 10 000. €1,689/L → 16890
  pricePerLiterE4 Int
  totalCents      Int
  fullTank        Boolean  @default(true)
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([workspaceId, vehicleId, date])
}

// ═══════════════════════════════════════════════════════════════════════════
// ORÇAMENTO
// ═══════════════════════════════════════════════════════════════════════════

model Budget {
  id          String   @id @default(cuid())
  workspaceId String
  /// Primeiro dia do mês a que respeita.
  month       DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lines     BudgetLine[]

  @@unique([workspaceId, month])
}

model BudgetLine {
  id           String @id @default(cuid())
  budgetId     String
  categoryId   String
  plannedCents Int    @default(0)

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
}

// ═══════════════════════════════════════════════════════════════════════════
// AUDITORIA
// ═══════════════════════════════════════════════════════════════════════════

/// Append-only. Um trigger impede UPDATE e DELETE — nem o código da app
/// consegue reescrever o passado. Nunca guardar palavras-passe nem tokens.
///
/// `workspaceId` e `userId` são scalars SEM relação formal, de propósito: uma
/// foreign key com ON DELETE SET NULL faria um UPDATE nesta tabela ao apagar
/// um workspace, e o trigger de imutabilidade recusaria — deixando o
/// workspace impossível de apagar. O registo de auditoria sobrevive ao que
/// audita.
model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String?
  userEmail   String?
  action      String
  entity      String?
  entityId    String?
  metadata    Json?
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}

/// Uma verificacao contra o extrato do banco.
///
/// Guarda-se para a app saber HA QUANTO TEMPO ninguem confere. A diferenca
/// entre a app e o banco cresce devagar; o perigo nao e a diferenca de hoje,
/// e os quatro meses sem ninguem olhar.
model Reconciliation {
  id          String   @id @default(cuid())
  workspaceId String
  accountId   String
  /// Data do saldo conferido, nao a data em que se conferiu.
  date        DateTime @db.Date
  bankCents   Int
  appCents    Int
  diffCents   Int
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([workspaceId, accountId, date])
}
